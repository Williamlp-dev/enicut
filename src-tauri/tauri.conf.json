{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ENICUT",
  "version": "0.3.0",
  "identifier": "com.enicut.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ENICUT",
        "width": 1100,
        "height": 680,
        "minWidth": 800,
        "minHeight": 520,
        "decorations": false,
        "resizable": true,
        "backgroundColor": [15, 14, 16, 255]
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; media-src 'self' asset: http://asset.localhost blob:; img-src 'self' asset: http://asset.localhost data: blob:; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "fileAssociations": [
      {
        "ext": ["mp4", "mkv", "mov", "avi", "webm", "m4v"],
        "name": "Video",
        "description": "Video File",
        "role": "Editor"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQxMTc4NEI0NzZGOEFFNEEKUldSS3J2aDJ0SVFYUVNiTWJPcDhwaUY0YmRESE13T21FQU51MXVheDZ6UDR3ZEN2WGVBZmlQUUcK",
      "endpoints": [
        "https://github.com/Williamlp-dev/enicut/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
