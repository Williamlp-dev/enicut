{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ENICUT",
  "version": "0.1.0",
  "identifier": "com.enicut.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ENICUT",
        "width": 1100,
        "height": 680,
        "minWidth": 800,
        "minHeight": 520,
        "decorations": false,
        "resizable": true,
        "backgroundColor": [15, 14, 16, 255]
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; media-src 'self' asset: http://asset.localhost blob:; img-src 'self' asset: http://asset.localhost data: blob:; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "fileAssociations": [
      {
        "ext": ["mp4", "mkv", "mov", "avi", "webm", "m4v"],
        "name": "Video",
        "description": "Video File",
        "role": "Editor"
      }
    ]
  }
}
